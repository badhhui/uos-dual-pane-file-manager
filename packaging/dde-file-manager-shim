#!/bin/sh
# Compatibility shim for Deepin/UOS file manager D-Bus "ShowItems"/"ShowFolders".
# WPS and other applications call dde-file-manager --show-item <uri>.
# Only that explicit "show item" call is forwarded to our file manager so it can
# select and highlight the file. All other DDE file manager calls pass through.
REAL_DDE="${DDE_FILE_MANAGER_REAL:-/usr/bin/dde-file-manager.real}"
APP="${UOS_FILE_MANAGER_BIN:-/usr/bin/uos-dual-pane-file-manager}"

show_item=0
item=""
for arg in "$@"; do
    case "$arg" in
        --show-item|--show-items)
            show_item=1
            ;;
        --*)
            # Ignore --raw and other DDE switches.
            ;;
        *)
            if [ "$show_item" = 1 ] && [ -z "$item" ]; then
                item="$arg"
            fi
            ;;
    esac
done

if [ "$show_item" = 1 ] && [ -n "$item" ]; then
    exec "$APP" --reveal "$item"
fi

if [ -x "$REAL_DDE" ]; then
    exec "$REAL_DDE" "$@"
fi
exec "$APP" "$@"
